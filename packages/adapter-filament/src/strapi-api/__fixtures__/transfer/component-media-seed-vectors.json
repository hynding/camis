{
  "about": "The data strapi-php's export of transfer/component-media-export.tar.gz holds: run on an empty strapi-php project (with the fixture's types), seeded with a full-access token, then `php bin/strapi export --no-encrypt -f component-media-export`. Files linked from the items of a repeatable component (Storyboard.frames, each frame's image) and from an embedded one (Storyboard.seo.metaImage): two storyboards share a file, one frame has none, a book's own cover links the same file as a frame, one storyboard has no seo and one an seo holding only its file; a landing's zone holds frames, one linking a file and one none, beside a hero.",
  "seed": [],
  "reads": [],
  "writes": [
    {
      "name": "a wide image",
      "path": "/upload",
      "as": "files:Wide",
      "upload": [
        {
          "file": "wide.png",
          "info": {
            "alternativeText": "red"
          }
        }
      ]
    },
    {
      "name": "a tall image",
      "path": "/upload",
      "as": "files:Tall",
      "upload": [
        {
          "file": "tall.png",
          "info": {
            "alternativeText": "blue"
          }
        }
      ]
    },
    {
      "name": "a storyboard whose frames link files",
      "method": "POST",
      "path": "/storyboards",
      "as": "storyboards:Opening",
      "data": {
        "title": "Opening",
        "frames": [
          {
            "caption": "Wide shot",
            "image": "#files:Wide"
          },
          {
            "caption": "Blank"
          },
          {
            "caption": "Close up",
            "image": "#files:Tall"
          }
        ],
        "seo": {
          "metaTitle": "Opening",
          "metaImage": "#files:Tall"
        }
      }
    },
    {
      "name": "another storyboard sharing a file",
      "method": "POST",
      "path": "/storyboards",
      "as": "storyboards:Closing",
      "data": {
        "title": "Closing",
        "frames": [
          {
            "caption": "Again",
            "image": "#files:Wide"
          }
        ]
      }
    },
    {
      "name": "a book whose cover is a frame's file too",
      "method": "POST",
      "path": "/books",
      "as": "books:Covered",
      "data": {
        "title": "Covered",
        "cover": "#files:Wide"
      }
    },
    {
      "name": "a storyboard whose embedded seo links a file and has no title",
      "method": "POST",
      "path": "/storyboards",
      "as": "storyboards:Trailer",
      "data": {
        "title": "Trailer",
        "seo": {
          "metaImage": "#files:Wide"
        }
      }
    },
    {
      "name": "a landing whose zone's frames link files",
      "method": "POST",
      "path": "/landings",
      "as": "landings:Framed",
      "data": {
        "title": "Framed",
        "blocks": [
          {
            "__component": "shared.frame",
            "caption": "Zoned",
            "image": "#files:Tall"
          },
          {
            "__component": "shared.hero",
            "heading": "Between"
          },
          {
            "__component": "shared.frame",
            "caption": "Empty"
          }
        ]
      }
    }
  ]
}
