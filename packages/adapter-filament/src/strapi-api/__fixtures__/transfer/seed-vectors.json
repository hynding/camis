{
  "about": "The data strapi-php's export of transfer/strapi-php-export.tar.gz holds: run on an empty strapi-php project (with the fixture's types and the fr locale), then register the user alice (POST /api/auth/local/register, password secret123) and `php bin/strapi export --no-encrypt -f strapi-php-export`. Every Strapi feature an archive carries: components, relations both ways, draft and published versions, locales, a dynamic zone, media with their files, and a user.",
  "seed": [
    { "path": "/authors", "as": "authors:Ann", "data": { "name": "Ann" } },
    { "path": "/authors", "as": "authors:Bob", "data": { "name": "Bob" } },
    { "path": "/genres", "as": "genres:Fantasy", "data": { "name": "Fantasy" } },
    { "path": "/genres", "as": "genres:Horror", "data": { "name": "Horror" } },
    { "path": "/topics", "as": "topics:Live", "data": { "name": "Live" } },
    {
      "path": "/topics",
      "query": "status=draft",
      "as": "topics:DraftOnly",
      "data": { "name": "DraftOnly" }
    },
    { "path": "/categories", "as": "categories:News", "data": { "name": "News" } },
    {
      "path": "/landings",
      "as": "landings:Home",
      "data": {
        "title": "Home",
        "blocks": [
          {
            "__component": "shared.hero",
            "heading": "Hi",
            "subheading": "Welcome",
            "price": { "minor": 5, "currency": "EUR" }
          },
          { "__component": "shared.quantity", "amount": 2, "unit": "kg" }
        ]
      }
    },
    { "path": "/pages", "as": "pages:Home", "data": { "title": "Home" } }
  ],
  "reads": [],
  "writes": [
    {
      "name": "an image",
      "path": "/upload",
      "as": "files:Wide",
      "upload": [
        { "file": "wide.png", "info": { "alternativeText": "red", "caption": "A red box" } }
      ]
    },
    {
      "name": "a text file",
      "path": "/upload",
      "as": "files:Notes",
      "upload": [{ "file": "notes.txt", "info": { "name": "my-notes.txt" } }]
    },
    {
      "name": "a book with components, relations and media",
      "method": "POST",
      "path": "/books",
      "as": "books:Alpha",
      "data": {
        "title": "Alpha",
        "pages": 100,
        "rating": 4.5,
        "inStock": true,
        "publishedOn": "2024-05-01",
        "releasedAt": "2024-05-01T10:30:00.000Z",
        "price": { "minor": 1999, "currency": "USD" },
        "editions": [
          { "amount": 1, "unit": "ea" },
          { "amount": 2.5, "unit": "kg" }
        ],
        "author": "@authors:Ann",
        "genres": ["@genres:Fantasy", "@genres:Horror"],
        "topic": "@topics:Live",
        "category": "@categories:News",
        "cover": "#files:Wide",
        "attachments": ["#files:Notes", "#files:Wide"]
      }
    },
    {
      "name": "a plain book",
      "method": "POST",
      "path": "/books",
      "as": "books:Beta",
      "data": { "title": "Beta", "author": "@authors:Bob" }
    },
    {
      "name": "a published post",
      "method": "POST",
      "path": "/posts",
      "as": "posts:Live",
      "data": {
        "title": "Live",
        "views": 3,
        "author": "@authors:Ann",
        "topics": ["@topics:Live", "@topics:DraftOnly"],
        "image": "#files:Wide"
      }
    },
    {
      "name": "its draft, edited",
      "method": "PUT",
      "path": "/posts/@posts:Live",
      "query": "status=draft",
      "data": { "title": "Live (edited)" }
    },
    {
      "name": "a draft post",
      "method": "POST",
      "path": "/posts",
      "query": "status=draft",
      "as": "posts:Draft",
      "data": { "title": "Draft", "author": "@authors:Bob" }
    },
    {
      "name": "a category in French",
      "method": "PUT",
      "path": "/categories/@categories:News",
      "query": "locale=fr",
      "data": { "name": "Actualités" }
    },
    {
      "name": "an article",
      "method": "POST",
      "path": "/articles",
      "as": "articles:Hello",
      "data": {
        "title": "Hello",
        "code": "A1",
        "category": "@categories:News",
        "genres": ["@genres:Fantasy"]
      }
    },
    {
      "name": "the article in French",
      "method": "PUT",
      "path": "/articles/@articles:Hello",
      "query": "locale=fr",
      "data": { "title": "Bonjour" }
    },
    {
      "name": "a page's French draft",
      "method": "PUT",
      "path": "/pages/@pages:Home",
      "query": "locale=fr&status=draft",
      "data": { "title": "Accueil" }
    }
  ]
}
