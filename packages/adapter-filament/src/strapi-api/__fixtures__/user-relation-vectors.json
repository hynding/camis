{
  "about": "Strapi 5 relations to the users-permissions user, checked against strapi-php. Run on an empty database with the token of a caller whose role may read users; a step marked public is sent without it, as the public role, which may not. '@type:Name' is that row's documentId, '#type:Name' its numeric id. Responses are compared after dropping the id, documentId, createdAt, updatedAt and publishedAt keys.",
  "seed": [
    {
      "path": "/auth/local/register",
      "as": "users:Ann",
      "raw": true,
      "data": {
        "username": "ann",
        "email": "ann@example.test",
        "password": "secret1"
      }
    },
    {
      "path": "/auth/local/register",
      "as": "users:Bob",
      "raw": true,
      "data": {
        "username": "bob",
        "email": "bob@example.test",
        "password": "secret1"
      }
    },
    {
      "path": "/reviews",
      "as": "reviews:First",
      "data": {
        "title": "First",
        "reviewer": "@users:Ann",
        "readers": ["@users:Ann", "@users:Bob"]
      }
    },
    {
      "path": "/reviews",
      "as": "reviews:Second",
      "data": {
        "title": "Second",
        "reviewer": "#users:Bob"
      }
    },
    {
      "path": "/reviews",
      "as": "reviews:Third",
      "data": {
        "title": "Third"
      }
    }
  ],
  "reads": [
    {
      "name": "no populate: the user relations are left out",
      "path": "/reviews",
      "query": "sort=title"
    },
    {
      "name": "populate a to-one user relation",
      "path": "/reviews",
      "query": "populate=reviewer&sort=title"
    },
    {
      "name": "populate=* reaches both user relations",
      "path": "/reviews/@reviews:First",
      "query": "populate=*"
    },
    {
      "name": "a populated user keeps the fields asked for",
      "path": "/reviews/@reviews:First",
      "query": "populate[reviewer][fields][0]=username"
    },
    {
      "name": "a to-many user relation counted",
      "path": "/reviews/@reviews:First",
      "query": "populate[readers][count]=true"
    },
    {
      "name": "a to-many user relation filtered",
      "path": "/reviews/@reviews:First",
      "query": "populate[readers][filters][username][$eq]=bob"
    },
    {
      "name": "filter by a user's field",
      "path": "/reviews",
      "query": "filters[reviewer][username][$eq]=ann"
    },
    {
      "name": "filter by a to-many user relation",
      "path": "/reviews",
      "query": "filters[readers][username][$eq]=bob&sort=title"
    },
    {
      "name": "the user's role is not populated for a caller who may not read roles",
      "path": "/reviews/@reviews:First",
      "query": "populate[reviewer][populate]=role"
    },
    {
      "name": "public: populate=* leaves the user relations out",
      "path": "/reviews/@reviews:First",
      "query": "populate=*",
      "public": true
    },
    {
      "name": "public: populating a user relation leaves it out",
      "path": "/reviews",
      "query": "populate=reviewer&sort=title",
      "public": true
    },
    {
      "name": "public: filtering by a user relation is an invalid key",
      "path": "/reviews",
      "query": "filters[reviewer][username][$eq]=ann",
      "public": true
    },
    {
      "name": "GraphQL: user relations resolve to the users-permissions user",
      "graphql": "{ reviews(sort: \"title\") { title reviewer { username email } readers { username } readers_connection { nodes { username } } } }"
    },
    {
      "name": "GraphQL: filter by a user's field",
      "graphql": "{ reviews(filters: { reviewer: { username: { eq: \"bob\" } } }) { title } }"
    },
    {
      "name": "GraphQL public: the user relations of a caller who may not read users",
      "graphql": "{ reviews(sort: \"title\") { title reviewer { username } readers { username } } }",
      "public": true
    }
  ],
  "writes": [
    {
      "name": "create linking users by id and by connect",
      "path": "/reviews",
      "query": "populate=*",
      "as": "reviews:Fourth",
      "data": {
        "title": "Fourth",
        "reviewer": "#users:Ann",
        "readers": {
          "connect": ["@users:Bob"]
        }
      }
    },
    {
      "name": "update: unlink the to-one user",
      "method": "PUT",
      "path": "/reviews/@reviews:Fourth",
      "query": "populate=*",
      "data": {
        "reviewer": null
      }
    },
    {
      "name": "update: disconnect a to-many user",
      "method": "PUT",
      "path": "/reviews/@reviews:Fourth",
      "query": "populate=*",
      "data": {
        "readers": {
          "disconnect": [
            {
              "documentId": "@users:Bob"
            }
          ]
        }
      }
    },
    {
      "name": "a user that does not exist is refused",
      "path": "/reviews",
      "data": {
        "title": "Fifth",
        "reviewer": "missing-user"
      }
    },
    {
      "name": "public: writing a user relation is an invalid key",
      "path": "/reviews",
      "data": {
        "title": "Sixth",
        "reviewer": "@users:Ann"
      },
      "public": true
    },
    {
      "name": "public: a write without the user relations is allowed",
      "path": "/reviews",
      "query": "populate=*",
      "data": {
        "title": "Seventh"
      },
      "public": true
    },
    {
      "name": "GraphQL: create linking users",
      "graphql": "mutation($data: ReviewInput!) { createReview(data: $data) { title reviewer { username } readers { username } } }",
      "variables": {
        "data": {
          "title": "Eighth",
          "reviewer": "@users:Bob",
          "readers": ["@users:Ann"]
        }
      }
    }
  ]
}
